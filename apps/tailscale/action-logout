#!/bin/bash
# 退出登录：这台机器离开 tailnet，软件保留。
# 随后按上次的设置发起网页登录，应用页直接给出「打开登录页」——
# 只是拿到链接，没人授权就不会入网（回归 H9：原来退出后页面上没有任何重新登录的入口）。
set -euo pipefail
cd "$(dirname "$0")"
. ./lib/obox.sh
. ./common.sh
command -v tailscale >/dev/null 2>&1 || obox_fail "Tailscale 未安装"
ts_stop_pending_login
tailscale logout || obox_fail "退出登录失败"
echo "[tailscale] 已退出登录，重新获取登录链接"
ts_relogin_with_saved_params
exec bash ./status   # 同伴脚本一律显式用解释器调用（上传的文件没有执行权限）
