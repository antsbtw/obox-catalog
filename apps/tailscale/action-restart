#!/bin/bash
# 重启 tailscaled。未登录时重启会丢掉登录链接 —— 按上次的设置重新发起网页登录，
# 用户不必再点「安装」。
set -euo pipefail
cd "$(dirname "$0")"
. ./lib/obox.sh
. ./common.sh
command -v tailscale >/dev/null 2>&1 || obox_fail "Tailscale 未安装"
systemctl restart tailscaled || obox_fail "重启失败"
sleep 2
if [ "$(ts_backend_state)" != "Running" ] && [ -z "$(ts_auth_url)" ]; then
  STATE_DIR=$(obox_state_dir tailscale)
  HN=$(sed -n 's/^hostname=//p' "$STATE_DIR/params" 2>/dev/null || true)
  EX=$(sed -n 's/^exit_node=//p' "$STATE_DIR/params" 2>/dev/null || true)
  SSHP=$(sed -n 's/^ssh=//p' "$STATE_DIR/params" 2>/dev/null || true)
  echo "[tailscale] 未登录，重新获取登录链接"
  ts_build_up_args "$HN" "${EX:-false}" "${SSHP:-false}"
  ts_start_web_login "${TS_UP_ARGS[@]}"
fi
exec bash ./status   # 同伴脚本一律显式用解释器调用（上传的文件没有执行权限）
